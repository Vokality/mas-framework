FROM ghcr.io/astral-sh/uv:0.12.23-python3.14-trixie-slim@sha256:8e88a074b0969bdc461f681727238e109438d70771828909f9ef19cfcc96c43a

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --silent --show-error --location \
        https://download.redis.io/releases/redis-8.10.2.tar.gz --output /tmp/redis.tar.gz \
    && echo 'b9ffee226b5eecdba98a679260dad764b2a4ebd90dce4ad5ac9e9f3eef9c02b3  /tmp/redis.tar.gz' | sha256sum --check \
    && tar -xzf /tmp/redis.tar.gz -C /tmp \
    && make -C /tmp/redis-8.10.2 -j2 BUILD_TLS=yes MALLOC=libc redis-server redis-cli \
    && install /tmp/redis-8.10.2/src/redis-server /tmp/redis-8.10.2/src/redis-cli /usr/local/bin/ \
    && rm -rf /tmp/redis.tar.gz /tmp/redis-8.10.2

WORKDIR /workspace
ENV UV_PROJECT_ENVIRONMENT=/opt/mas-venv
COPY pyproject.toml uv.lock pytest.ini conftest.py ./
COPY packages ./packages
COPY integration_tests ./integration_tests
COPY tools ./tools
RUN uv sync --frozen --all-groups --all-packages

CMD ["uv", "run", "--frozen", "python", "-m", "tools.validate_production"]
